cabal-version:      1.12
name:               morpheus-graphql-subscriptions
version:            0.28.4
license:            MIT
license-file:       LICENSE
copyright:          (c) 2019 Daviti Nalchevanidze
maintainer:         d.nalchevanidze@gmail.com
author:             Daviti Nalchevanidze
homepage:           https://morpheusgraphql.com
bug-reports:        https://github.com/nalchevanidze/morpheus-graphql/issues
synopsis:           Morpheus GraphQL Subscriptions
description:        Build GraphQL APIs with your favourite functional language!
category:           web, graphql, subscriptions
build-type:         Simple
extra-source-files:
    README.md
    changelog.md

source-repository head
    type:     git
    location: https://github.com/nalchevanidze/morpheus-graphql

library
    exposed-modules:
        Nested.Extra.SecondStub
        Nested.Stub

    hs-source-dirs:   src
    other-modules:    Paths_morpheus_graphql_subscriptions
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        aeson >=1.4.4 && <3.0.0,
        base >=4.7.0 && <5.0.0,
        bytestring >=0.10.4 && <1.0.0,
        morpheus-graphql-app >=0.28.0 && <0.29.0,
        morpheus-graphql-core >=0.28.0 && <0.29.0,
        mtl >=2.0.0 && <3.0.0,
        relude >=0.3.0 && <2.0.0,
        text >=1.2.3 && <3.0.0,
        transformers >=0.3.0 && <1.0.0,
        unliftio-core >=0.0.1 && <1.0.0,
        unordered-containers >=0.2.8 && <1.0.0,
        uuid >=1.0.0 && <2.0.0,
        websockets >=0.12.6.0 && <1.0.0
