#!/bin/sh
set -eu

usage() {
  echo "usage:" >&2
  echo "  $0 log-call <tool> [args...]" >&2
  echo "  $0 write-file <path> [content...]" >&2
  echo "  $0 maybe-install [cmd] [args...]" >&2
}

log_file_path() {
  echo "${HWM_GOLDEN_INVOCATIONS:-.hwm/invocations.yaml}"
}

append_call() {
  tool="$1"
  shift

  log="$(log_file_path)"
  mkdir -p "$(dirname "$log")"
  if [ ! -f "$log" ] || [ ! -s "$log" ]; then
    : > "$log"
  fi

  printf -- "- tool: %s\n" "$tool" >> "$log"
  printf -- "  args:\n" >> "$log"
  for a in "$@"; do
    printf -- "    - %s\n" "$a" >> "$log"
  done

  if [ -n "${CABAL_PROJECT_FILE:-}" ]; then
    printf -- "  cabal_project_file: %s\n" "$(basename "$CABAL_PROJECT_FILE")" >> "$log"
    if [ -f "$CABAL_PROJECT_FILE" ]; then
      printf -- "  cabal_project_content: |\n" >> "$log"
      cat "$CABAL_PROJECT_FILE" | sed 's/^/    /' >> "$log"
    fi
  fi

  if [ -n "${STACK_YAML:-}" ]; then
    printf -- "  stack_yaml: %s\n" "$(basename "$STACK_YAML")" >> "$log"
    if [ -f "$STACK_YAML" ]; then
      printf -- "  stack_yaml_content: |\n" >> "$log"
      cat "$STACK_YAML" | sed 's/^/    /' >> "$log"
    fi
  fi
}

write_file() {
  path="$1"
  shift

  mkdir -p "$(dirname "$path")"

  if [ "$#" -gt 0 ]; then
    printf -- "%s\n" "$*" > "$path"
  else
    cat > "$path"
  fi
}

maybe_install() {
  cmd="${1:-}"
  out_dir=""
  targets=""

  if [ "$#" -gt 0 ]; then
    shift
  fi

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --installdir|--local-bin-path)
        out_dir="${2:-}"
        shift 2
        ;;
      --*)
        shift
        ;;
      *)
        targets="$targets $1"
        shift
        ;;
    esac
  done

  if [ "$cmd" = "install" ] && [ -n "$out_dir" ]; then
    mkdir -p "$out_dir"
    for t in $targets; do
      case "$t" in
        all|all:exes)
          continue
          ;;
      esac
      bin_name=$(basename "$t")
      printf '#!/bin/sh\necho fake-binary-%s\n' "$bin_name" > "$out_dir/$bin_name"
      chmod +x "$out_dir/$bin_name"
    done
  fi
}

cmd="${1:-}"
[ -n "$cmd" ] || {
  usage
  exit 2
}
shift

case "$cmd" in
  log-call)
    [ "$#" -ge 1 ] || {
      usage
      exit 2
    }
    append_call "$@"
    ;;
  write-file)
    [ "$#" -ge 1 ] || {
      usage
      exit 2
    }
    write_file "$@"
    ;;
  maybe-install)
    maybe_install "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac
